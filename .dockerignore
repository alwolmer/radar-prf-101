# Ignore local virtual environments.
.venv/
venv/
ENV/

# Ignore Python and Spark caches.
**/__pycache__/
**/.pytest_cache/
.ipynb_checkpoints/
.ivy2/

# Ignore generated data and extracted archives.
data/
tmp/
*.zip
*.shp
*.dbf
*.shx
*.prj

# Ignore Git metadata.
.git/
.gitignore

# Ignore local-only configuration and files not needed for the image build.
.env
.codex/
config/
documentation/
notebooks/
src/
tests/
*.md
dvc.lock
dvc.yaml
Makefile
