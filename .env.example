# Datalake backend: "local" or "s3"
DATALAKE_BACKEND=local

# Local datalake root used when DATALAKE_BACKEND=local
DATALAKE_LOCAL_ROOT=./data

# S3 datalake settings used when DATALAKE_BACKEND=s3
DATALAKE_S3_BUCKET=your-bucket-name
DATALAKE_S3_PREFIX=
DATALAKE_S3_REGION=us-east-1
DATALAKE_S3_ENDPOINT=
