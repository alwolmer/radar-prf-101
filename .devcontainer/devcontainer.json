{
  "name": "Radar PRF Spark Env",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "spark-env",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvInSelectedTerminal": true
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "remoteUser": "root",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "apt-get update && apt-get install -y make && pre-commit install"
}
