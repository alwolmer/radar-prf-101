# Spark and Sedona runtime coordinates used by the containerized ETL jobs.
SPARK_VERSION=3.5
SCALA_VERSION=2.12
SEDONA_VERSION=1.5.1
GEOTOOLS_WRAPPER_VERSION=1.5.1-28.2
HADOOP_AWS_VERSION=3.4.2
AWS_JAVA_SDK_BUNDLE_VERSION=1.12.367
SPARK_MAVEN_REPOSITORIES=https://artifacts.unidata.ucar.edu/repository/unidata-all/

# Shared Spark runtime defaults for local ETL execution.
SPARK_LOG_LEVEL=WARN
SPARK_DRIVER_MEMORY=2g
SPARK_DEFAULT_PARALLELISM=4
SPARK_SQL_SHUFFLE_PARTITIONS=4
SPARK_SQL_DEBUG_MAX_TO_STRING_FIELDS=200
PARQUET_BLOCK_SIZE=33554432
SPARK_EVENTLOG_GC_METRICS_YOUNG_GENERATION_GARBAGE_COLLECTORS="G1 Young Generation"
SPARK_EVENTLOG_GC_METRICS_OLD_GENERATION_GARBAGE_COLLECTORS="G1 Old Generation,G1 Concurrent GC"

# Shared Python logging defaults for ETL jobs.
ETL_LOG_LEVEL=INFO
